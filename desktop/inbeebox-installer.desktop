[Desktop Entry]
Name=INBEEBOX Auto-Installer
GenericName=Gestor de Paquetes y Herramientas IA
Comment=Instala y extrae paquetes .deb, archivos .zip y herramientas de IA con resúmenes automáticos
Exec=inbeebox-installer %F
Icon=inbeebox
Terminal=false
Type=Application
Categories=System;Utility;PackageManager;
MimeType=application/vnd.debian.binary-package;application/zip;application/x-tar;application/x-compressed-tar;
Keywords=package;deb;installer;zip;extract;ai;ollama;colmena;
StartupNotify=true
